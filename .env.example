# Required for AI generation. Each friend should use their own key.
CEREBRAS_API_KEY=

# Optional
CEREBRAS_API_BASE=https://api.cerebras.ai/v1
GAR_DEFAULT_MODEL=qwen-3.8-27b
GAR_DATA_DIR=./data
GAR_MAX_HTML_BYTES=1500000

# Prices in USD per token as of 2026-09-15. Override if pricing changes.
GAR_QWEN_INPUT_USD_PER_TOKEN=0.00000099
GAR_QWEN_OUTPUT_USD_PER_TOKEN=0.00000149
GAR_GPTOSS_INPUT_USD_PER_TOKEN=0.00000035
GAR_GPTOSS_OUTPUT_USD_PER_TOKEN=0.00000075
